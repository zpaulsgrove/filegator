{
  "name": "filegator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "composer install && npm i && concurrently \"php -S 0.0.0.0:8081\" \"vue-cli-service serve --port 8080\"",
    "build": "vue-cli-service build --no-clean",
    "test:unit": "vue-cli-service test:unit",
    "pretest:e2e": "npm run build",
    "test:e2e": "node tests/frontend/e2e/support/with-e2e-config.js start-server-and-test 'php -S 0.0.0.0:8081' http://localhost:8081 'cypress run'",
    "pretest:e2e:mfa-required": "npm run build",
    "test:e2e:mfa-required": "node tests/frontend/e2e/support/with-e2e-config.js start-server-and-test 'php -S 0.0.0.0:8081' http://localhost:8081 'cypress run --spec tests/frontend/e2e/specs-mfa-required/**/*.cy.js'",
    "pretest:e2e:headed": "npm run build",
    "test:e2e:headed": "node tests/frontend/e2e/support/with-e2e-config.js start-server-and-test 'php -S 0.0.0.0:8081' http://localhost:8081 'cypress run --headed'",
    "lint": "vue-cli-service lint --no-fix frontend/",
    "pree2e": "npm run build",
    "e2e": "node tests/frontend/e2e/support/with-e2e-config.js start-server-and-test 'php -S 0.0.0.0:8081' http://localhost:8081 'cypress open'",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "core-js": "^3.6.5",
    "js-base64": "^2.5.2",
    "moment": "^2.30.1",
    "prismjs": "^1.20.0",
    "qrcode": "^1.5.3",
    "vue-lazyload": "^1.3.3",
    "vue-prism-editor": "^0.5.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^5.13.0",
    "@vue/cli-plugin-babel": "^4.3.1",
    "@vue/cli-plugin-eslint": "^4.3.1",
    "@vue/cli-plugin-unit-jest": "^4.3.1",
    "@vue/cli-service": "^4.3.1",
    "@vue/test-utils": "1.0.0-beta.29",
    "axios": "^0.21.1",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^24.9.0",
    "buefy": "^0.7.10",
    "concurrently": "^4.1.2",
    "cypress": "^14.0.0",
    "eslint": "^5.16.0",
    "eslint-plugin-vue": "^5.0.0",
    "resumablejs": "^1.1.0",
    "sass": "^1.82.0",
    "sass-loader": "^7.3.1",
    "start-server-and-test": "^2.0.0",
    "vue": "^2.6.11",
    "vue-clipboard2": "^0.3.1",
    "vue-router": "^3.1.6",
    "vue-template-compiler": "^2.6.11",
    "vuex": "^3.4.0"
  }
}

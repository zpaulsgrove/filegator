{
    // Mutation testing scoped to the security-critical backend services, where a
    // flipped comparison or TTL operator is a real vulnerability that line coverage
    // cannot catch. See tests/backend/Unit/{MfaLockout,MfaSecretCrypto,...}Test.php.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "backend/Services/Auth",
            "backend/Services/Mfa",
            "backend/Services/PasswordReset"
        ],
        "excludes": [
            // Thin adapters marked @codeCoverageIgnore with no unit coverage.
            // Paths are relative to the source directories above (Infection resolves
            // excludes within each source folder), so these sit under backend/Services/Auth.
            "Adapters/LDAP.php",
            "Adapters/WPAuth.php"
        ]
    },
    "mutators": {
        "@default": true,
        // Visibility mutators (protected<->public) almost never change testable
        // behaviour, so they show up as unkillable "equivalent" survivors and
        // just depress the score. Disable them so the MSI reflects real gaps.
        "ProtectedVisibility": false,
        "PublicVisibility": false
    },
    "logs": {
        "text": "tests/backend/infection.log",
        // Machine-readable report (per-mutant verdicts + MSI summary) for tracking
        // the baseline over time. Configured here, not via a CLI flag (Infection
        // 0.29 has no --logger-json option).
        "json": "tests/backend/infection.json"
    },
    "testFramework": "phpunit",
    // The covering tests for this code are slow (argon2 password hashing, sodium
    // crypto, the lockout sleep) so the default per-mutant timeout skips most
    // mutants. 30s lets far more of them actually run; the weekly cadence absorbs
    // the longer wall-clock.
    "timeout": 30,
    // Baseline on CI (PHP 8.3, pcov, timeout 30), measured across four dispatched
    // runs on master: Covered MSI ~66.4-68%, MSI ~61-62%, mutation coverage ~91%.
    // Many mutants exceed 30s (argon2 / sodium / HTTP covering tests) and are
    // skipped, so raw MSI swings with CI load — gate only on Covered MSI, which is
    // computed over the mutants that actually run and is stable run-to-run.
    //
    // minCoveredMsi is set to 64: ~2.4 points below the lowest observed value
    // (66.4%) so normal run-to-run variance (~1.5 pts) can't false-fail, while a
    // real drop in assertion strength still trips it. Ratcheted up from 60 after
    // Infection itself flagged the floor was 6+ points below measured. Keep
    // ratcheting as coverage of the slow paths improves. minMsi stays 0 on
    // purpose — it is dominated by the timeout-skip count, not by test quality,
    // so gating on it would be flaky.
    "minMsi": 0,
    "minCoveredMsi": 64
}
